# syntax=docker/dockerfile:1

ARG BASE_IMAGE=ghcr.io/endstonemc/manylinux_2_31_x86_64:latest
FROM ${BASE_IMAGE}

ARG LLVM_VERSION=20

LABEL org.opencontainers.image.title="Endstone manylinux_2_31_x86_64 + LLVM" \
      org.opencontainers.image.description="manylinux_2_31_x86_64 with the LLVM toolchain and libc++ preinstalled." \
      org.opencontainers.image.source="https://github.com/EndstoneMC/endstone" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="EndstoneMC"

RUN apt-get update -y -q \
    && apt-get install -y -q --no-install-recommends ca-certificates curl \
    && curl -fsSL --retry 10 --retry-delay 5 --retry-connrefused \
        https://apt.llvm.org/llvm-snapshot.gpg.key \
        -o /etc/apt/trusted.gpg.d/apt.llvm.org.asc \
    && echo "deb https://apt.llvm.org/focal/ llvm-toolchain-focal-${LLVM_VERSION} main" \
        > /etc/apt/sources.list.d/llvm.list \
    && apt-get update -y -q -o Acquire::Retries=10 \
    && apt-get install -y -q --no-install-recommends -o Acquire::Retries=10 \
        clang-${LLVM_VERSION} \
        lld-${LLVM_VERSION} \
        libc++-${LLVM_VERSION}-dev \
        libc++abi-${LLVM_VERSION}-dev \
    && update-alternatives --install /usr/bin/clang clang /usr/bin/clang-${LLVM_VERSION} 100 \
    && update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-${LLVM_VERSION} 100 \
    && rm -rf /var/lib/apt/lists/*

ENV CC=/usr/bin/clang \
    CXX=/usr/bin/clang++
